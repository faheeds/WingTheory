NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live commerce needs a server database, authentication, payment processor,
# delivery-zone service and provider accounts. These are intentionally absent
# from the local demo and should only be added with their corresponding code.
# Keep public preview deployments out of search results until real ordering is ready.
NEXT_PUBLIC_SITE_MODE=preview

# Test checkout remains closed unless both flags are set outside production.
# Never use a live Stripe key with these flags.
NEXT_PUBLIC_CHECKOUT_MODE=demo
STRIPE_CHECKOUT_TEST_MODE=disabled
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# DATABASE_URL=...
# UBER_DIRECT_CLIENT_ID=...
# UBER_DIRECT_CLIENT_SECRET=...
# UBER_DIRECT_CUSTOMER_ID=...
